---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { base } from '../lib/posts';

interface Props { title?: string; description?: string; wide?: boolean }
const { title, description = 'Personal day-wise engineering blog, comprehensive study handbooks, AI news, and research paper summaries by Sahaj Saliya.', wide = false } = Astro.props;
const fullTitle = title ? `${title} · Sahaj Saliya` : "Sahaj Saliya · AI & Engineering Handbook";
const FONTS = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap';
const path = Astro.url.pathname;
const nav = [
  ['learning-path/', 'Curriculum'],
  ['study/', 'Study Notes'],
  ['papers/', 'Research Papers'],
  ['ai/', 'AI Updates'],
  ['archive/', 'Archive'],
  ['search/', 'Search'],
  ['about/', 'About'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(path, Astro.site)} />
  <link rel="alternate" type="application/rss+xml" title="Sahaj Saliya's Blog" href={base('rss.xml')} />
  <link rel="icon" href={base('favicon.svg')} type="image/svg+xml" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Sahaj Saliya · AI & Engineering Handbook" />
  <meta property="og:url" content={new URL(path, Astro.site)} />
  <meta name="author" content="Sahaj Saliya" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:creator" content="@SahajS59" />
  <meta name="theme-color" content="#090d16" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href={FONTS} onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href={FONTS} /></noscript>
  <script is:inline>
    try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-head">
    <div class="wide">
      <a class="brand" href={base()}>
        <span class="brand-badge" aria-label="Active system status"></span>
        Sahaj<span>.</span>blogs
      </a>
      <nav class="nav" aria-label="Main Navigation">
        {nav.map(([href, label]) => (
          <a href={base(href)} aria-current={path.startsWith(base(href)) ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <div class="header-actions">
        <a href={base('search/')} class="theme-btn" aria-label="Search posts">
          🔍 <span class="label">Search</span>
        </a>
        <button class="theme-btn" id="theme" type="button" aria-label="Toggle theme">
          ◐ <span class="label">Theme</span>
        </button>
      </div>
    </div>
  </header>
  <main id="main">
    <div class={wide ? 'wide' : 'wrap'}>
      <slot />
    </div>
  </main>
  <footer class="site-foot">
    <div class="wide">
      <div>
        © Sahaj Saliya · B.Tech ICT at PDEU (2023–2027)
      </div>
      <div>
        <a href="https://info.sahaj.si" target="_blank" rel="noopener">Portfolio</a> · 
        <a href="https://github.com/SahajIVVIX-1" target="_blank" rel="noopener">GitHub</a> · 
        <a href="https://x.com/SahajS59" target="_blank" rel="noopener">X / Twitter</a> · 
        <a href="https://www.linkedin.com/in/sahajs59" target="_blank" rel="noopener">LinkedIn</a> · 
        <a href={base('rss.xml')}>RSS Feed</a>
      </div>
    </div>
  </footer>
  <script is:inline>
    document.getElementById('theme').addEventListener('click', () => {
      const root = document.documentElement;
      const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      root.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
    });
  </script>
</body>
</html>
