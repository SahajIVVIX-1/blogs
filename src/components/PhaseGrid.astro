---
import { phaseProgress, base, fmtDate, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  limit?: number;
}
const { posts, limit } = Astro.props;
const phases = phaseProgress(posts);
const displayPhases = limit ? phases.slice(0, limit) : phases;
---
<div class="phases-grid">
  {displayPhases.map((ph) => {
    const pct = Math.round((ph.done / ph.total) * 100);
    return (
      <a class="phase-card" href={base(`learning-path/#phase-${ph.n}`)}>
        <div class="phase-header">
          <span class="phase-tag">Phase {ph.n}</span>
          <span class="phase-dates">{fmtDate(ph.from).slice(3)} – {fmtDate(ph.to).slice(3)}</span>
        </div>
        <h3 class="phase-title">{ph.name}</h3>
        <div class="phase-progress-bar">
          <div class="phase-progress-fill" style={`width:${pct}%`}></div>
        </div>
        <div class="phase-meta">
          <span>{ph.done} of {ph.total} guides</span>
          <span style="font-weight:600">{pct}% completed</span>
        </div>
      </a>
    );
  })}
</div>

