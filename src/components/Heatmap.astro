---
// GitHub-style calendar: one cell per day from START to today, grouped by year.
import { START, today, dayKey, dayUrl, base, CATEGORY_LABEL, type Post } from '../lib/posts';
interface Props { days: Map<string, Post[]> }
const { days } = Astro.props;

const end = new Date(today() + 'T00:00:00Z');
const years: { year: number; cells: (null | { key: string; n: number; cats: string[] })[] }[] = [];
for (let y = Number(START.slice(0, 4)); y <= end.getUTCFullYear(); y++) {
  const from = new Date(Math.max(Date.parse(`${y}-01-01`), Date.parse(START)));
  const to = new Date(Math.min(Date.parse(`${y}-12-31`), end.getTime()));
  const cells: (null | { key: string; n: number; cats: string[] })[] = [];
  for (let i = 0; i < from.getUTCDay(); i++) cells.push(null); // align to Sunday rows
  for (const d = new Date(from); d <= to; d.setUTCDate(d.getUTCDate() + 1)) {
    const key = dayKey(d);
    const ps = days.get(key) ?? [];
    cells.push({ key, n: ps.length, cats: [...new Set(ps.flatMap((p) => p.data.categories.map((c) => CATEGORY_LABEL[c])))] });
  }
  years.unshift({ year: y, cells });
}
const level = (n: number) => (n === 0 ? '' : n === 1 ? 'l1' : n === 2 ? 'l2' : n === 3 ? 'l3' : 'l4');
---
<section class="activity-card" aria-label="Posting Activity Calendar">
  <details>
    <summary class="activity-card-header">
      <h3 class="activity-card-title">
        <span>📅</span> Daily Publishing Activity & Streak Heatmap
      </h3>
      <span class="btn btn-outline" style="padding:4px 10px;font-size:0.8rem">Toggle Calendar</span>
    </summary>
    
    <p class="activity-desc">
      Every active square represents published, verified learning notes, arXiv paper digests, or official AI releases. Click any day to jump to its daily journal.
    </p>

    {years.map(({ year, cells }) => (
      <div style="margin-top:1rem">
        <div class="heat-year">{year}</div>
        <div class="heat-scroll">
          <div class="heat" aria-hidden="true">
            {cells.map((c) =>
              !c ? <span class="pad" /> :
              c.n ? <span class={`${level(c.n)} has`} data-href={dayUrl(c.key)} title={`${c.key}: ${c.n} post${c.n > 1 ? 's' : ''} · ${c.cats.join(', ')}`} /> :
              <span title={`${c.key}: no posts`} />
            )}
          </div>
        </div>
      </div>
    ))}
    
    <div class="heat-legend">
      <span>Less</span>
      <i style="background:var(--heat-0)" />
      <i style="background:var(--heat-1)" />
      <i style="background:var(--heat-2)" />
      <i style="background:var(--heat-3)" />
      <i style="background:var(--heat-4)" />
      <span>More active</span>
      <span style="margin-left:auto">
        <a href={base('archive/')}>Browse full archive by date →</a>
      </span>
    </div>
  </details>
</section>

<script is:inline>
  document.querySelectorAll('.heat').forEach((grid) => grid.addEventListener('click', (e) => {
    const href = e.target.dataset && e.target.dataset.href;
    if (href) location.href = href;
  }));
</script>
