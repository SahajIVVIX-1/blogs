---
import { stats, type Post } from '../lib/posts';
interface Props { posts: Post[] }
const s = stats(Astro.props.posts);
---
<div class="stats-grid">
  <div class="stat-card">
    <span class="stat-num">{s.total}</span>
    <span class="stat-label">📚 Published Technical Notes</span>
  </div>
  <div class="stat-card">
    <span class="stat-num">{s.study}</span>
    <span class="stat-label">🎓 Curriculum Study Guides</span>
  </div>
  <div class="stat-card">
    <span class="stat-num">{s.papers}</span>
    <span class="stat-label">📄 Research Paper Digests</span>
  </div>
  <div class="stat-card">
    <span class="stat-num">{s.ai}</span>
    <span class="stat-label">⚡ Major AI Releases</span>
  </div>
  <div class="stat-card">
    <span class="stat-num">{s.days}</span>
    <span class="stat-label">🗓️ Total Active Posting Days</span>
  </div>
</div>
