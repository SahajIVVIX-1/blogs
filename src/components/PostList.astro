---
import { postUrl, fmtDate, CATEGORY_LABEL, CATEGORY_ICON, readingTime, phaseOf, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  showDate?: boolean;
}
const { posts, showDate = true } = Astro.props;
---
<div class="post-cards-grid">
  {posts.map((p) => {
    const cat = p.data.categories[0] ?? 'study';
    const phase = phaseOf(p.data.phase);
    const read = readingTime(p);
    return (
      <article class="post-card">
        <div class="post-card-meta">
          <span class={`badge badge-${cat}`}>
            {CATEGORY_ICON[cat]} {CATEGORY_LABEL[cat]}
          </span>
          {phase && (
            <span class="badge-phase">
              Phase {phase.n}: {phase.name}
            </span>
          )}
          <span class="read-time">⏱️ {read}</span>
        </div>
        
        <h3 class="post-card-title">
          <a href={postUrl(p)}>{p.data.title}</a>
        </h3>
        
        {p.data.summary && (
          <p class="post-card-desc">{p.data.summary}</p>
        )}
        
        <div class="post-card-foot">
          <div>
            {showDate && <span>{fmtDate(p.data.date)}</span>}
            {p.data.sources.length > 0 && (
              <span class="muted"> · {p.data.sources.length} verified source{p.data.sources.length > 1 ? 's' : ''}</span>
            )}
          </div>
          <a href={postUrl(p)} class="post-card-action">
            Read article →
          </a>
        </div>
      </article>
    );
  })}
</div>
