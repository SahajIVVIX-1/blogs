---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import PhaseGrid from '../components/PhaseGrid.astro';
import { allPosts, base } from '../lib/posts';

const all = await allPosts();
const posts = all.filter((p) => p.data.categories.includes('study') || p.data.categories.includes('projects'));
---
<Base title="Study Guides & Curriculum" wide>
  <section class="hero" style="padding-top:1.5rem;padding-bottom:1.5rem;">
    <div class="hero-pill">
      <span>📚</span> Structured Curriculum Tracks
    </div>
    <h1 class="hero-title" style="font-size: clamp(2rem, 4vw, 2.8rem);">
      Study Notes & Engineering Guides
    </h1>
    <p class="hero-desc">
      In-depth, topic-by-topic learning guides organized sequentially from foundational programming and mathematics to modern Agentic AI. Every study guide includes conceptual explanations, mathematical derivations, runnable code snippets, and verified outputs.
    </p>
    <div>
      <a href={base('learning-path/')} class="btn btn-primary">
        View Vertical Learning Roadmap →
      </a>
    </div>
  </section>

  <!-- Phase Overview Grid -->
  <section style="margin: 2rem 0;">
    <h2>Curriculum Tracks (15 Phases)</h2>
    <p class="muted">Click any track to explore its sequential lessons and topics.</p>
    <PhaseGrid posts={all} />
  </section>

  <!-- Guides Feed -->
  <section style="margin: 3rem 0;">
    <h2>All Study Guides ({posts.length})</h2>
    <p class="muted">Chronological stream of technical study notes across all phases.</p>
    <PostList posts={posts} />
  </section>
</Base>
