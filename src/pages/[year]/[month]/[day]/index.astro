---
import Base from '../../../../layouts/Base.astro';
import { allPosts, byDay, dayUrl, postUrl, fmtDate, CATEGORY_LABEL, CATEGORY_ICON, readingTime, type Post } from '../../../../lib/posts';

export async function getStaticPaths() {
  const days = byDay(await allPosts());
  const keys = [...days.keys()].sort();
  return keys.map((k, i) => {
    const [year, month, day] = k.split('-');
    return { params: { year, month, day }, props: { key: k, posts: days.get(k)!.slice().reverse(), prev: keys[i - 1], next: keys[i + 1] } };
  });
}
const { key, posts, prev, next } = Astro.props as { key: string; posts: Post[]; prev?: string; next?: string };
---
<Base title={`Day ${key}`} description={`Technical posts and notes from ${fmtDate(key)}`}>
  <div style="margin:1rem 0 2rem;">
    <span class="badge badge-phase">Daily Journal</span>
    <h1 style="margin:0.4rem 0 0.3rem;">{fmtDate(key)}</h1>
    <p class="muted">All technical entries and updates published on this day.</p>
  </div>

  <div style="display:grid;gap:16px;">
    {posts.map((p) => {
      const cat = p.data.categories[0] ?? 'study';
      return (
        <article class="post-card">
          <div class="post-card-meta">
            <span class={`badge badge-${cat}`}>
              {CATEGORY_ICON[cat]} {CATEGORY_LABEL[cat]}
            </span>
            <span class="read-time">⏱️ {readingTime(p)}</span>
          </div>

          <h2 style="font-size:1.35rem;margin:0 0 0.4rem;">
            <a href={postUrl(p)} style="color:var(--ink);">{p.data.title}</a>
          </h2>

          <p class="post-card-desc">{p.data.summary}</p>

          {p.data.highlights.length > 0 && (
            <div class="attn" style="margin:0.8rem 0;">
              <strong style="font-size:0.8rem;text-transform:uppercase;color:var(--accent);display:block;margin-bottom:4px;">Key Takeaways</strong>
              <ul style="margin:0;padding-left:1.2rem;">
                {p.data.highlights.map((h) => <li>{h}</li>)}
              </ul>
            </div>
          )}

          <div class="post-card-foot">
            <span class="muted">{p.data.sources.length} cited source{p.data.sources.length > 1 ? 's' : ''}</span>
            <a href={postUrl(p)} class="post-card-action">Read complete entry →</a>
          </div>
        </article>
      );
    })}
  </div>

  <nav class="pager" aria-label="Day Navigation">
    {prev ? <a href={dayUrl(prev)} class="btn btn-outline" style="font-size:0.85rem;">← {fmtDate(prev)}</a> : <span />}
    {next ? <a href={dayUrl(next)} class="btn btn-primary" style="font-size:0.85rem;">{fmtDate(next)} →</a> : <span />}
  </nav>
</Base>
