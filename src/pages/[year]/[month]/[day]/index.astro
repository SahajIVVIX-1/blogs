---
import Base from '../../../../layouts/Base.astro';
import { allPosts, byDay, dayUrl, postUrl, fmtDate, CATEGORY_LABEL, type Post } from '../../../../lib/posts';

export async function getStaticPaths() {
  const days = byDay(await allPosts());
  const keys = [...days.keys()].sort();
  return keys.map((k, i) => {
    const [year, month, day] = k.split('-');
    return { params: { year, month, day }, props: { key: k, posts: days.get(k)!.slice().reverse(), prev: keys[i - 1], next: keys[i + 1] } };
  });
}
const { key, posts, prev, next } = Astro.props as { key: string; posts: Post[]; prev?: string; next?: string };
---
<Base title={`Day ${key}`} description={`Posts from ${fmtDate(key)}`}>
  <p class="label muted">Day page</p>
  <h1>{fmtDate(key)}</h1>
  {posts.map((p) => (
    <article style="margin:1.6rem 0 2rem">
      <div>{p.data.categories.map((c) => <span class="chip cat">{CATEGORY_LABEL[c]}</span>)}</div>
      <h2 style="margin-top:0.3rem"><a href={postUrl(p)} style="color:inherit;text-decoration:none">{p.data.title}</a></h2>
      <p>{p.data.summary}</p>
      {p.data.highlights.length > 0 && (
        <ul class="attn" aria-label="Key sentences">
          {p.data.highlights.map((h, i) => <li style={`--w:${1 - i * 0.2}`}>{h}</li>)}
        </ul>
      )}
      <p><a href={postUrl(p)}>Read the post →</a></p>
    </article>
  ))}
  <nav class="pager" aria-label="Day navigation">
    {prev ? <a href={dayUrl(prev)}>← {fmtDate(prev)}</a> : <span />}
    {next ? <a href={dayUrl(next)}>{fmtDate(next)} →</a> : <span />}
  </nav>
</Base>
