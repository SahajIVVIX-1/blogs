---
import { render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import { allPosts, slugOf, dayKey, dayUrl, postUrl, fmtDate, base, CATEGORY_LABEL, CATEGORY_ICON, readingTime, type Post } from '../../../../lib/posts';
import phases from '../../../../data/learning-path.json';

export async function getStaticPaths() {
  const posts = await allPosts();
  const studyByPhase = new Map<number, Post[]>();
  for (const q of posts) {
    if (q.data.phase && q.data.step) {
      if (!studyByPhase.has(q.data.phase)) studyByPhase.set(q.data.phase, []);
      studyByPhase.get(q.data.phase)!.push(q);
    }
  }
  for (const list of studyByPhase.values()) {
    list.sort((a, b) => a.data.step! - b.data.step!);
  }

  return posts.map((p) => {
    const [year, month, day] = dayKey(p.data.date).split('-');
    const study = p.data.phase ? (studyByPhase.get(p.data.phase) ?? []) : [];
    const i = study.findIndex((q) => q.id === p.id);
    return {
      params: { year, month, day, slug: slugOf(p) },
      props: { post: p, prev: i > 0 ? study[i - 1] : undefined, next: i >= 0 ? study[i + 1] : undefined },
    };
  });
}

const { post, prev, next } = Astro.props as { post: Post; prev?: Post; next?: Post };
const { Content } = await render(post);
const d = post.data;
const phase = d.phase ? phases.find((p) => p.n === d.phase) : undefined;
const key = dayKey(d.date);
const read = readingTime(post);
---
<Base title={d.title} description={d.summary}>
  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" style="font-size:0.85rem;color:var(--muted);margin-bottom:1.2rem;">
    <a href={base()}>Home</a>
    <span> / </span>
    {phase ? (
      <>
        <a href={base('study/')}>Study</a>
        <span> / </span>
        <a href={base(`learning-path/#phase-${phase.n}`)}>Phase {phase.n}: {phase.name}</a>
      </>
    ) : (
      <a href={base(d.categories[0] + '/')}>{CATEGORY_LABEL[d.categories[0]] ?? 'Archive'}</a>
    )}
    <span> / </span>
    <span>{key}</span>
  </nav>

  <article data-pagefind-body>
    <div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-bottom:0.8rem;">
      {d.categories.map((c) => (
        <span class={`badge badge-${c}`} data-pagefind-filter="category">
          {CATEGORY_ICON[c]} {CATEGORY_LABEL[c]}
        </span>
      ))}
      {phase && (
        <a class="badge-phase" href={base('learning-path/#phase-' + phase.n)}>
          Phase {phase.n} · {phase.name} {d.step ? `(Step ${d.step})` : ''}
        </a>
      )}
      <span class="read-time">⏱️ {read}</span>
      <span class="muted" style="font-size:0.85rem;"> · Published {fmtDate(d.date)}</span>
    </div>

    <h1 class="post-title" style="font-size: clamp(1.6rem, 4.5vw, 2.8rem);margin-bottom:0.8rem;word-break:break-word;">{d.title}</h1>
    
    {d.summary && (
      <p class="post-lede">
        {d.summary}
      </p>
    )}

    {d.card && d.papers[0] && (
      <aside class="model-card" aria-label="Paper Summary Card">
        <span class="label" style="font-weight:700;color:var(--badge-papers);letter-spacing:0.04em;">📄 RESEARCH PAPER CARD</span>
        <dl>
          <dt>Paper</dt><dd><strong>{d.papers[0].title}</strong> ({d.papers[0].year})</dd>
          <dt>Authors</dt><dd>{d.papers[0].authors.slice(0, 6).join(', ')}{d.papers[0].authors.length > 6 ? ' et al.' : ''}</dd>
          <dt>Task</dt><dd>{d.card.task}</dd>
          <dt>Method</dt><dd>{d.card.method}</dd>
          {d.card.data && <><dt>Dataset</dt><dd>{d.card.data}</dd></>}
          <dt>Key Result</dt><dd><strong>{d.card.result}</strong></dd>
          <dt>Links</dt><dd style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
            {d.papers[0].arxiv && <a href={d.papers[0].arxiv} target="_blank" rel="noopener" class="btn btn-outline" style="padding:2px 8px;font-size:0.75rem;">arXiv Page ↗</a>}
            {d.papers[0].pdf && <a href={d.papers[0].pdf} target="_blank" rel="noopener" class="btn btn-outline" style="padding:2px 8px;font-size:0.75rem;">PDF Full Text ↗</a>}
            {d.papers[0].code && <a href={d.papers[0].code} target="_blank" rel="noopener" class="btn btn-outline" style="padding:2px 8px;font-size:0.75rem;">Code Repository ↗</a>}
          </dd>
        </dl>
      </aside>
    )}

    {d.cover && (
      <figure>
        <img class="cover" src={base(d.cover)} alt={d.images[0]?.alt ?? ''} loading="lazy" decoding="async" />
        {d.cover_credit && <figcaption set:html={d.cover_credit} />}
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>

    {d.tags.length > 0 && (
      <div style="margin:2rem 0;display:flex;flex-wrap:wrap;gap:6px;align-items:center;">
        <span class="label muted" style="margin-right:4px;">TAGS:</span>
        {d.tags.map((t) => (
          <a class="filter-tab" style="padding:2px 10px;font-size:0.78rem;" href={base(`tags/${t}/`)}>#{t}</a>
        ))}
      </div>
    )}

    <section class="sources">
      <h3>Verified Primary Sources</h3>
      <ol>
        {d.sources.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener">{s.title}</a>
            <span class="muted"> — {s.publisher}</span>
          </li>
        ))}
      </ol>
      {!d.categories.includes('study') && (
        <p class="muted" style="font-size:0.85rem;margin-top:0.8rem;">
          This article is a factual summary composed strictly from the cited public sources. Benchmarks and metrics reflect official reports.
        </p>
      )}
    </section>
  </article>

  {(prev || next) && (
    <nav class="pager" aria-label="Curriculum Navigation">
      {prev ? (
        <a href={postUrl(prev)} class="btn btn-outline" style="font-size:0.85rem;">
          ← Previous: {prev.data.title}
        </a>
      ) : <span />}
      {next ? (
        <a href={postUrl(next)} class="btn btn-primary" style="font-size:0.85rem;">
          Next: {next.data.title} →
        </a>
      ) : <span />}
    </nav>
  )}
</Base>
