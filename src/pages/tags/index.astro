---
import Base from '../../layouts/Base.astro';
import { allPosts, base } from '../../lib/posts';
const counts = new Map<string, number>();
for (const p of await allPosts()) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---
<Base title="Tags">
  <h1>Tags</h1>
  <p>{tags.map(([t, n]) => <a class="chip" href={base(`tags/${t}/`)}>#{t} <span>{n}</span></a>)}</p>
</Base>
