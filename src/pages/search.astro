---
import Base from '../layouts/Base.astro';
import { base } from '../lib/posts';
---
<Base title="Search">
  <h1>Search</h1>
  <link href={base('pagefind/pagefind-ui.css')} rel="stylesheet" />
  <div id="search"></div>
  <noscript>Search needs JavaScript. Try the <a href={base('archive/')}>archive</a> instead.</noscript>
  <script is:inline define:vars={{ src: base('pagefind/pagefind-ui.js') }}>
    const s = document.createElement('script');
    s.src = src;
    s.onload = () => new PagefindUI({ element: '#search', showSubResults: true, showImages: false });
    s.onerror = () => { document.getElementById('search').textContent = 'The search index is built with `npm run build`; it is not available in dev mode.'; };
    document.head.appendChild(s);
  </script>
  <style is:global>
    #search { --pagefind-ui-primary: var(--accent); --pagefind-ui-text: var(--ink); --pagefind-ui-background: var(--surface); --pagefind-ui-border: var(--line); --pagefind-ui-tag: var(--accent-soft); --pagefind-ui-font: var(--sans); }
  </style>
</Base>
