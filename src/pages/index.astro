---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Heatmap from '../components/Heatmap.astro';
import StatsStrip from '../components/StatsStrip.astro';
import { allPosts, byDay, base } from '../lib/posts';
const posts = await allPosts();
---
<Base wide>
  <h1>Learning in public, one day at a time</h1>
  <p class="muted" style="max-width:62ch">Study notes from my path through Python, ML and AI, plus summaries of AI news and papers from public sources. Every post links its sources.</p>
  <StatsStrip posts={posts} />
  <Heatmap days={byDay(posts)} />
  <div class="wrap" style="padding:0;margin:2rem 0 0">
    <h2>Latest</h2>
    <PostList posts={posts.slice(0, 15)} />
    <p><a href={base('archive/')}>All posts in the archive →</a></p>
  </div>
</Base>
